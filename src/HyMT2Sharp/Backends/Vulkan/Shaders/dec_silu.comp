#version 450
// gate[i] = silu(gate[i]) * up[i]
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer G { float gate[]; };
layout(set = 0, binding = 1) readonly buffer U { float up[]; };

layout(push_constant) uniform PC { uint n; } pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float gv = gate[i];
    gate[i] = gv / (1.0f + exp(-gv)) * up[i];
}
