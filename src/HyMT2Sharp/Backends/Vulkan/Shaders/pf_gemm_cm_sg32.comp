#version 450

#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// C[M,N] = X[M,K](fp16) * W[N,K](fp16)^T (+ R[M,N] fp32 when flags&1).
// Shared-memory staged coopmat GEMM for subgroup-32 (NVIDIA/AMD):
// acc = coopmat 16x8 f32 (no M8 shape exists there); A = 16x16, B = 16x8.
// TSM x TSN subgroup grid; each sg owns a (BM/TSM) x (BN/TSN) strip of
// AI x AJ accumulators. Double-buffered shared tiles (f16vec4): stage the
// next K-chunk while the current one computes, one barrier per chunk.
#ifndef BM
#define BM 128
#endif
#ifndef BN
#define BN 128
#endif
#ifndef KB
#define KB 8          // K-chunk in vec4 units (32 f16 elems)
#endif
#ifndef TSM
#define TSM 2
#endif
#ifndef TSN
#define TSN 4
#endif
#ifndef NTHR
#define NTHR 256
#endif
#ifndef ACCM
#define ACCM 16
#endif
#ifndef ACCN
#define ACCN 8
#endif

layout(local_size_x = NTHR) in;

layout(set = 0, binding = 0) readonly buffer X { f16vec4 x[]; };
layout(set = 0, binding = 1) readonly buffer W { f16vec4 w[]; };
layout(set = 0, binding = 2) readonly buffer R { float r[]; };
layout(set = 0, binding = 3) buffer C { float c[]; };

layout(push_constant) uniform PC { uint mDim; uint nDim; uint kDim; uint flags; } p;

const uint STRM = BM / TSM;          // sg strip rows
const uint STRN = BN / TSN;          // sg strip cols
const uint AI = STRM / ACCM;           // acc rows per sg (acc is 16x8)
const uint AJ = STRN / ACCN;            // acc cols per sg
const uint NSG = TSM * TSN;

shared f16vec4 xs[2 * BM * KB];      // [bank][m][k]
shared f16vec4 ws[2 * BN * KB];      // [bank][n][k]
shared float stage[NSG * ACCM * ACCN];    // per-sg acc staging

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint m0 = gl_WorkGroupID.x * BM;
    uint n0 = gl_WorkGroupID.y * BN;
    uint sg = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint sgx = sg % TSN, sgy = sg / TSN;

    coopmat<float, gl_ScopeSubgroup, ACCM, ACCN, gl_MatrixUseAccumulator> acc[AI][AJ];
    for (uint i = 0u; i < uint(AI); i++)
        for (uint j = 0u; j < uint(AJ); j++)
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, ACCM, ACCN, gl_MatrixUseAccumulator>(0.0f);

    uint kv = p.kDim >> 2;             // kDim in vec4 units
    const uint XSLOTS = BM * KB, WSLOTS = BN * KB;

    // stage chunk 0 into bank 0
    for (uint s = tid; s < XSLOTS; s += NTHR) {
        uint row = s / KB, col = s % KB;
        uint gm = m0 + row;
        xs[s] = (gm < p.mDim) ? x[gm * kv + col] : f16vec4(0.0);
    }
    for (uint s = tid; s < WSLOTS; s += NTHR) {
        uint row = s / KB, col = s % KB;
        uint gn = n0 + row;
        ws[s] = (gn < p.nDim) ? w[gn * kv + col] : f16vec4(0.0);
    }
    barrier();

    uint bank = 0u;
    for (uint kb = 0u; kb < kv; kb += KB) {
        // stage next chunk into the other bank while this one computes
        if (kb + KB < kv) {
            uint xo = (1u - bank) * XSLOTS;
            uint wo = (1u - bank) * WSLOTS;
            for (uint s = tid; s < XSLOTS; s += NTHR) {
                uint row = s / KB, col = s % KB;
                uint gm = m0 + row;
                xs[xo + s] = (gm < p.mDim) ? x[gm * kv + kb + KB + col] : f16vec4(0.0);
            }
            for (uint s = tid; s < WSLOTS; s += NTHR) {
                uint row = s / KB, col = s % KB;
                uint gn = n0 + row;
                ws[wo + s] = (gn < p.nDim) ? w[gn * kv + kb + KB + col] : f16vec4(0.0);
            }
        }
        // compute current bank (independent of the staging stores)
        uint xo = bank * XSLOTS;
        uint wo = bank * WSLOTS;
        for (uint kk = 0u; kk < KB; kk += 4u) {   // 16-elem K sub-tiles
            coopmat<float16_t, gl_ScopeSubgroup, ACCM, 16, gl_MatrixUseA> ma[AI];
            for (uint i = 0u; i < uint(AI); i++)
                coopMatLoad(ma[i], xs, xo + (sgy * STRM + i * ACCM) * KB + kk, KB, gl_CooperativeMatrixLayoutRowMajor);
            coopmat<float16_t, gl_ScopeSubgroup, 16, ACCN, gl_MatrixUseB> mb[AJ];
            for (uint j = 0u; j < uint(AJ); j++)
                coopMatLoad(mb[j], ws, wo + (sgx * STRN + j * ACCN) * KB + kk, KB, gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < uint(AI); i++)
                for (uint j = 0u; j < uint(AJ); j++)
                    acc[i][j] = coopMatMulAdd(ma[i], mb[j], acc[i][j]);
        }
        barrier();   // joins staged writes (next bank) and completed reads (this bank)
        bank = 1u - bank;
    }

    bool hasR = (p.flags & 1u) != 0u;
    for (uint i = 0u; i < uint(AI); i++) {
        for (uint j = 0u; j < uint(AJ); j++) {
            coopMatStore(acc[i][j], stage, sg * (ACCM * ACCN), ACCM, gl_CooperativeMatrixLayoutColumnMajor);
            barrier();
            uint rm = sgy * STRM + i * ACCM;
            uint cn = sgx * STRN + j * ACCN;
            for (uint l = 0u; l < ACCM * ACCN / 32u; l++) {
                uint e = lane * (ACCM * ACCN / 32u) + l;
                uint mm = e % ACCM, nn = e / ACCM;
                uint gmr = m0 + rm + mm;
                uint gnc = n0 + cn + nn;
                if (gmr < p.mDim && gnc < p.nDim) {
                    uint idx = gmr * p.nDim + gnc;
                    c[idx] = hasR ? (r[idx] + stage[sg * (ACCM * ACCN) + nn * ACCM + mm]) : stage[sg * (ACCM * ACCN) + nn * ACCM + mm];
                }
            }
            barrier();
        }
    }
}
