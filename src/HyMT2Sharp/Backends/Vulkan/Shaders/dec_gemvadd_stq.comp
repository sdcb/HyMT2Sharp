#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require

// y[row] += Wstq[row,:] dot xv. 16 rows/WG, 16 lanes/row (same map as q8_gemv).
// STQ1_0 block = 42B per 256 weights (= one superblock):
//   Qs[32] @0  = 64 groups x 4-bit codebook slot (2 groups/byte)
//   Sign[8] @32 = one global sign bit per group
//   fp16 d @40
// Group g covers positions (g>>4)*64 + (g&15) + t*16, t=0..3: its 4-bit slot and
// sign select a 32-entry codebook qpack holding four 2-bit ternary lanes (code-1).
// Lane l covers chunk c = l>>2, groups i4*4+j (i4 = l&3, j = 0..3):
//   Qs u16 @ 8c + 2i4 holds the 4 groups' slots (byte j>>1, nibble j&1)
//   Sign u16 @ 32 + 2c holds bits for groups 16c..16c+15 (bit 4i4+j).
// All reads even-offset -> u16 view.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer W16 { uint w16[]; };
layout(set = 0, binding = 1) readonly buffer XV { vec4 xv[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };

layout(push_constant) uniform PC { uint in_dim; uint out_dim; } p;

shared float red[256];

const uint STQ_CB[32] = uint[](
    0xA9u, 0x89u, 0x29u, 0x09u, 0xA6u, 0x86u, 0x26u, 0x06u,
    0x9Au, 0x92u, 0x1Au, 0x12u, 0x6Au, 0x62u, 0x4Au, 0x42u,
    0x01u, 0x21u, 0x81u, 0xA1u, 0x04u, 0x24u, 0x84u, 0xA4u,
    0x10u, 0x18u, 0x90u, 0x98u, 0x40u, 0x48u, 0x60u, 0x68u);

uint rd16(uint byteOff) { return (w16[byteOff >> 2] >> ((byteOff & 2u) << 3)) & 0xFFFFu; }

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint bpr = p.in_dim >> 8;          // 256-elem superblocks per row

    uint rowLane = tid >> 4;
    uint itid = tid & 15u;
    uint row = gl_WorkGroupID.x * 16u + rowLane;
    bool valid = row < p.out_dim;
    uint rowBytes = (valid ? row : 0u) * bpr * 42u;

    uint c = itid >> 2;                // 64-weight chunk within the block
    uint i4 = itid & 3u;               // 4 groups starting at 4*i4

    float acc = 0.0f;
    for (uint blk = 0u; blk < bpr; blk++) {
        uint bb = rowBytes + blk * 42u;
        float d = unpackHalf2x16(rd16(bb + 40u)).x;
        uint qs = rd16(bb + c * 8u + i4 * 2u);      // 2 bytes = 4 slot nibbles
        uint sg = rd16(bb + 32u + c * 2u);          // 16 sign bits for the chunk

        // decode the 4 groups' qpacks, then 4 lane-vec4 dots
        uint qp0 = STQ_CB[(((sg >> (i4 * 4u + 0u)) & 1u) << 4) | ((qs >> 0u)  & 0xFu)];
        uint qp1 = STQ_CB[(((sg >> (i4 * 4u + 1u)) & 1u) << 4) | ((qs >> 4u)  & 0xFu)];
        uint qp2 = STQ_CB[(((sg >> (i4 * 4u + 2u)) & 1u) << 4) | ((qs >> 8u)  & 0xFu)];
        uint qp3 = STQ_CB[(((sg >> (i4 * 4u + 3u)) & 1u) << 4) | ((qs >> 12u) & 0xFu)];

        uint kv = (blk << 6) + c * 16u + i4;
        acc += d * (
            dot(vec4(float(int(qp0 & 3u) - 1), float(int(qp1 & 3u) - 1),
                     float(int(qp2 & 3u) - 1), float(int(qp3 & 3u) - 1)), xv[kv]) +
            dot(vec4(float(int((qp0 >> 2u) & 3u) - 1), float(int((qp1 >> 2u) & 3u) - 1),
                     float(int((qp2 >> 2u) & 3u) - 1), float(int((qp3 >> 2u) & 3u) - 1)), xv[kv + 4u]) +
            dot(vec4(float(int((qp0 >> 4u) & 3u) - 1), float(int((qp1 >> 4u) & 3u) - 1),
                     float(int((qp2 >> 4u) & 3u) - 1), float(int((qp3 >> 4u) & 3u) - 1)), xv[kv + 8u]) +
            dot(vec4(float(int((qp0 >> 6u) & 3u) - 1), float(int((qp1 >> 6u) & 3u) - 1),
                     float(int((qp2 >> 6u) & 3u) - 1), float(int((qp3 >> 6u) & 3u) - 1)), xv[kv + 12u]));
    }

    red[tid] = acc;
    barrier();
    if (itid < 8u) red[tid] += red[tid + 8u];
    barrier();
    if (itid < 4u) red[tid] += red[tid + 4u];
    barrier();
    if (itid < 2u) red[tid] += red[tid + 2u];
    barrier();
    if (itid < 1u) red[tid] += red[tid + 1u];
    barrier();
    if (itid == 0u && valid) y[row] += red[tid];
}
