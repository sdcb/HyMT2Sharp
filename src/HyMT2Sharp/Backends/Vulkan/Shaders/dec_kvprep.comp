#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
// single WG: NeoX rope on q and k, per-head rmsnorm on q (qHeads x headDim)
// and k (kvHeads x headDim), then append k,v into fp16 KV caches at pos.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Q  { float q[]; };
layout(set = 0, binding = 1) buffer K  { float k[]; };
layout(set = 0, binding = 2) readonly buffer V  { float v[]; };
layout(set = 0, binding = 3) writeonly buffer KD { uint16_t kDst[]; };
layout(set = 0, binding = 4) writeonly buffer VD { uint16_t vDst[]; };
layout(set = 0, binding = 5) readonly buffer QN { float qnw[]; };
layout(set = 0, binding = 6) readonly buffer KN { float knw[]; };
layout(set = 0, binding = 7) readonly buffer P { int tokenId; int pos; int kvLen; } prm;

layout(push_constant) uniform PC {
    uint headDim; uint ropeDim; float base; uint qHeads; uint kvHeads; uint kDim; uint kvStride;
} pc;

shared float red[256];

uint16_t f2h(float f) { return uint16_t(packHalf2x16(vec2(f, 0.0f)) & 0xFFFFu); }

#define ROPE_ONE(arr, h, i) { \
    float freq = 1.0f / pow(pc.base, float(i) / float(hd)); \
    float a = float(prm.pos) * freq; \
    float c = cos(a), s = sin(a); \
    uint row = (h) * pc.headDim; \
    float x0 = arr[row + (i)], x1 = arr[row + (i) + hd]; \
    arr[row + (i)]      = x0 * c - x1 * s; \
    arr[row + (i) + hd] = x0 * s + x1 * c; \
}

// 16-thread team (rowLane) rmsnorms one head's headDim elems of arr.
#define RMS_TEAM(arr, warr, row) { \
    float _acc = 0.0f; \
    for (uint i = lane * epl; i < lane * epl + epl; i++) { \
        float x = arr[(row) * pc.headDim + i]; _acc += x * x; } \
    red[tid] = _acc; \
    barrier(); \
    if (lane < 8u) red[tid] += red[tid + 8u]; \
    barrier(); \
    if (lane < 4u) red[tid] += red[tid + 4u]; \
    barrier(); \
    if (lane < 2u) red[tid] += red[tid + 2u]; \
    barrier(); \
    if (lane < 1u) red[tid] += red[tid + 1u]; \
    barrier(); \
    float rstd = 1.0f / sqrt(red[tid & ~15u] / float(pc.headDim) + 1e-5f); \
    if (act) \
        for (uint i = lane * epl; i < lane * epl + epl; i++) \
            arr[(row) * pc.headDim + i] *= rstd * warr[i]; \
}

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint hd = pc.ropeDim >> 1;

    // phase 1: rope on q and k
    {
        uint n = pc.qHeads * hd;
        for (uint gid = tid; gid < n; gid += 256u) {
            uint h = gid / hd; uint i = gid - h * hd;
            ROPE_ONE(q, h, i);
        }
        n = pc.kvHeads * hd;
        for (uint gid = tid; gid < n; gid += 256u) {
            uint h = gid / hd; uint i = gid - h * hd;
            ROPE_ONE(k, h, i);
        }
    }
    barrier();

    // phase 2: per-head rmsnorm, 16-thread teams (only 16 teams exist:
    // q heads use all of them, k heads run in a second pass on teams 0-3)
    {
        uint rowLane = tid >> 4;
        uint lane = tid & 15u;
        uint epl = pc.headDim >> 4;
        bool act = rowLane < pc.qHeads;
        RMS_TEAM(q, qnw, act ? rowLane : 0u)
        barrier();
        act = rowLane < pc.kvHeads;
        RMS_TEAM(k, knw, act ? rowLane : 0u)
    }
    barrier();

    // phase 3: append k,v to fp16 caches
    for (uint i = tid; i < pc.kDim; i += 256u) {
        uint off = uint(prm.pos) * pc.kvStride + i;
        kDst[off] = f2h(k[i]);
        vDst[off] = f2h(v[i]);
    }
}
