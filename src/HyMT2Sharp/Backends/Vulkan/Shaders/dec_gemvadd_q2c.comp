#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require

// y[row] += Wq2c[row,:] dot xv. 16 rows/WG, 16 lanes/row (same map as q8_gemv).
// Block = 130B per 512 weights: fp16 d @0 + 2-bit qs[128] @2.
// One Q2_0C block spans two 256-elem superblocks; within a superblock lane l
// covers 16 weights = 4 qs bytes at offset 2 + (s&1)*64 + l*4 (even -> u16 reads).
// Code c = ((byte >> 2k) & 3); weight = (c*2-3) * d.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer W16 { uint w16[]; };
layout(set = 0, binding = 1) readonly buffer XV { vec4 xv[]; };
layout(set = 0, binding = 2) buffer Y { float y[]; };

layout(push_constant) uniform PC { uint in_dim; uint out_dim; } p;

shared float red[256];

uint rd16(uint byteOff) { return (w16[byteOff >> 2] >> ((byteOff & 2u) << 3)) & 0xFFFFu; }
uint rd32(uint byteOff) { return rd16(byteOff) | (rd16(byteOff + 2u) << 16); }

// 4 consecutive 2-bit codes starting at bit `sh` of u32 q -> vec4 of (c*2-3)
vec4 q2w(uint q, uint sh)
{
    return vec4(float(((q >> sh) & 3u) * 2u) - 3.0f,
                float(((q >> (sh + 2u)) & 3u) * 2u) - 3.0f,
                float(((q >> (sh + 4u)) & 3u) * 2u) - 3.0f,
                float(((q >> (sh + 6u)) & 3u) * 2u) - 3.0f);
}

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint bpr = p.in_dim >> 8;          // 256-elem superblocks per row

    uint rowLane = tid >> 4;
    uint itid = tid & 15u;
    uint row = gl_WorkGroupID.x * 16u + rowLane;
    bool valid = row < p.out_dim;
    uint rowBytes = (valid ? row : 0u) * bpr * 65u;   // (in_dim>>9)*130 = bpr*65

    float acc = 0.0f;
    for (uint blk = 0u; blk < bpr; blk++) {
        uint bb = rowBytes + (blk >> 1) * 130u;
        float d = unpackHalf2x16(rd16(bb)).x;
        uint q = rd32(bb + 2u + (blk & 1u) * 64u + itid * 4u);
        uint kv = (blk << 6) + itid * 4u;
        acc += d * (dot(xv[kv],      q2w(q, 0u))  + dot(xv[kv + 1u], q2w(q, 8u)) +
                    dot(xv[kv + 2u], q2w(q, 16u)) + dot(xv[kv + 3u], q2w(q, 24u)));
    }

    red[tid] = acc;
    barrier();
    if (itid < 8u) red[tid] += red[tid + 8u];
    barrier();
    if (itid < 4u) red[tid] += red[tid + 4u];
    barrier();
    if (itid < 2u) red[tid] += red[tid + 2u];
    barrier();
    if (itid < 1u) red[tid] += red[tid + 1u];
    barrier();
    if (itid == 0u && valid) y[row] += red[tid];
}
