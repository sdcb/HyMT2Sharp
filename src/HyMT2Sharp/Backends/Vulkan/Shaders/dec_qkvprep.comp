#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require

// fused QKV gemv + rope + q/k rmsnorm + fp16 KV append.
// 24 WGs = 16 q heads + 4 k heads + 4 v heads; each WG owns one head's full
// 128 output rows, so rope and per-head norm need no cross-WG sync.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer H  { float h[]; };
layout(set = 0, binding = 1) readonly buffer WN { float wn[]; };
layout(set = 0, binding = 2) readonly buffer WQ { uint wq[]; };
layout(set = 0, binding = 3) readonly buffer WK { uint wk[]; };
layout(set = 0, binding = 4) readonly buffer WV { uint wv[]; };
layout(set = 0, binding = 5) readonly buffer QN { float qnw[]; };
layout(set = 0, binding = 6) readonly buffer KN { float knw[]; };
layout(set = 0, binding = 7) readonly buffer P { int tokenId; int pos; int kvLen; int seq; } prm;
layout(set = 0, binding = 8) writeonly buffer OQ { float oq[]; };
layout(set = 0, binding = 9) writeonly buffer KK { uint16_t kk[]; };
layout(set = 0, binding = 10) writeonly buffer VV { uint16_t vv[]; };

layout(push_constant) uniform PC {
    uint in_dim; float eps;
    uint heads; uint kvHeads; uint headDim; uint ropeDim; uint kvStride;
    float base;
    uint tq; uint tk; uint tv;
} pc;

shared vec4 xs4[512];
shared float red[256];
shared float rowv[128];
shared float parts[2048];   // [lr][itid] lane partials across batches

#define R32(arr, off) (((off) & 2u) == 0u ? (arr[(off) >> 2]) : ((arr[(off) >> 2] >> 16) | (arr[((off) >> 2) + 1u] << 16)))
#define R16(arr, off) ((arr[(off) >> 2] >> (((off) & 2u) << 3)) & 0xFFFFu)
#define S8(arr, off)  int((int((arr[(off) >> 2] >> (((off) & 3u) << 3)) & 0xFFu) << 24) >> 24)

#define X4(i) xs4[i]
#define SX(i) (xs4[i].x + xs4[i].y + xs4[i].z + xs4[i].w)

#define GEMV_Q4K(arr, rlRow, bpr, itid, accOut) { \
    uint il = (itid) >> 2; \
    uint ir = (itid) & 3u; \
    uint v_im = il >> 1; \
    uint v_in = il & 1u; \
    uint l0 = ((2u * ir + v_in) << 2); \
    uint qw  = (v_im << 5) + l0; \
    uint xbase = (v_im << 4) + (l0 >> 2); \
    uint gA = 2u * v_im; \
    float _acc = 0.0f; \
    uint _rb = (rlRow) * (bpr) * 144u; \
    for (uint blk = 0u; blk < (bpr); blk++) { \
        uint bp = _rb + blk * 144u; \
        uint s0 = R32(arr, bp + 4u); \
        uint s1 = R32(arr, bp + 8u); \
        uint s2 = R32(arr, bp + 12u); \
        uint sh0 = gA * 8u, sh1 = sh0 + 8u, sh2 = sh0 + 14u; \
        vec2 ddm = unpackHalf2x16(R32(arr, bp)); \
        vec4 smA = vec4(ddm.x * float((s0 >> sh0) & 63u), ddm.y * float((s1 >> sh0) & 63u), \
                        ddm.x * float((s0 >> sh1) & 63u), ddm.y * float((s1 >> sh1) & 63u)); \
        vec4 smB = vec4(ddm.x * float(((s2 >> sh0) & 15u) | (((s0 >> (sh0 + 6u)) & 3u) << 4u)), \
                        ddm.y * float(((s2 >> (sh0 + 4u)) & 15u) | (((s1 >> (sh0 + 6u)) & 3u) << 4u)), \
                        ddm.x * float(((s2 >> sh1) & 15u) | (((s0 >> sh2) & 3u) << 4u)), \
                        ddm.y * float(((s2 >> (sh1 + 4u)) & 15u) | (((s1 >> sh2) & 3u) << 4u))); \
        uint qs0  = R32(arr, bp + 16u + qw); \
        uint qs64 = R32(arr, bp + 16u + qw + 64u); \
        vec4 q0l = vec4(float(qs0 & 15u), float((qs0 >> 8u) & 15u), \
                        float((qs0 >> 16u) & 15u), float((qs0 >> 24u) & 15u)); \
        vec4 q0h = vec4(float((qs0 >> 4u) & 15u), float((qs0 >> 12u) & 15u), \
                        float((qs0 >> 20u) & 15u), float(qs0 >> 28u)); \
        vec4 q64l = vec4(float(qs64 & 15u), float((qs64 >> 8u) & 15u), \
                         float((qs64 >> 16u) & 15u), float((qs64 >> 24u) & 15u)); \
        vec4 q64h = vec4(float((qs64 >> 4u) & 15u), float((qs64 >> 12u) & 15u), \
                         float((qs64 >> 20u) & 15u), float(qs64 >> 28u)); \
        uint kv = (blk << 6) + xbase; \
        _acc += smA.x * dot(X4(kv), q0l) - smA.y * SX(kv); \
        _acc += smA.z * dot(X4(kv + 8u), q0h) - smA.w * SX(kv + 8u); \
        _acc += smB.x * dot(X4(kv + 32u), q64l) - smB.y * SX(kv + 32u); \
        _acc += smB.z * dot(X4(kv + 40u), q64h) - smB.w * SX(kv + 40u); \
    } \
    accOut = _acc; \
}

#define GEMV_Q6K(arr, rlRow, bpr, itid, accOut) { \
    uint v_im = (itid) >> 3; \
    uint v_in = (itid) & 7u; \
    uint l0 = v_in << 2; \
    uint is = v_in >> 2; \
    uint qlb = (v_im << 6) + l0; \
    uint qhb = (v_im << 5) + l0; \
    uint soff = (v_im << 3) + is; \
    uint xoff = (v_im << 5) + (l0 >> 2); \
    float _acc = 0.0f; \
    uint _rb = (rlRow) * (bpr) * 210u; \
    for (uint blk = 0u; blk < (bpr); blk++) { \
        uint bb = _rb + blk * 210u; \
        uint ql0  = R32(arr, bb + qlb); \
        uint ql32 = R32(arr, bb + qlb + 32u); \
        uint qh   = R32(arr, bb + 128u + qhb); \
        float _d = unpackHalf2x16(R16(arr, bb + 208u) << 16).y; \
        float s0 = _d * float(S8(arr, bb + 192u + soff)); \
        float s1 = _d * float(S8(arr, bb + 194u + soff)); \
        float s2 = _d * float(S8(arr, bb + 196u + soff)); \
        float s3 = _d * float(S8(arr, bb + 198u + soff)); \
        uint q0u = (ql0 & 0x0F0F0F0Fu)        | ((qh & 0x03030303u) << 4); \
        uint q1u = (ql32 & 0x0F0F0F0Fu)       | ((qh & 0x0C0C0C0Cu) << 2); \
        uint q2u = ((ql0 >> 4) & 0x0F0F0F0Fu) | (qh & 0x30303030u); \
        uint q3u = ((ql32 >> 4) & 0x0F0F0F0Fu) | ((qh >> 2) & 0x30303030u); \
        vec4 q0 = vec4(float(q0u & 0xFFu), float((q0u >> 8u) & 0xFFu), float((q0u >> 16u) & 0xFFu), float(q0u >> 24u)) - 32.0f; \
        vec4 q1 = vec4(float(q1u & 0xFFu), float((q1u >> 8u) & 0xFFu), float((q1u >> 16u) & 0xFFu), float(q1u >> 24u)) - 32.0f; \
        vec4 q2 = vec4(float(q2u & 0xFFu), float((q2u >> 8u) & 0xFFu), float((q2u >> 16u) & 0xFFu), float(q2u >> 24u)) - 32.0f; \
        vec4 q3 = vec4(float(q3u & 0xFFu), float((q3u >> 8u) & 0xFFu), float((q3u >> 16u) & 0xFFu), float(q3u >> 24u)) - 32.0f; \
        uint kv = (blk << 6) + xoff; \
        _acc += s0 * dot(X4(kv),      q0); \
        _acc += s1 * dot(X4(kv + 8u),  q1); \
        _acc += s2 * dot(X4(kv + 16u), q2); \
        _acc += s3 * dot(X4(kv + 24u), q3); \
    } \
    accOut = _acc; \
}

float h2f(uint16_t h_) { return unpackHalf2x16(uint(h_)).x; }
uint16_t f2h(float f) { return uint16_t(packHalf2x16(vec2(f, 0.0f)) & 0xFFFFu); }

void main()
{
    uint tid = gl_LocalInvocationID.x;
    uint g = gl_WorkGroupID.x;                 // 0..15 q heads, 16..19 k, 20..23 v
    uint bpr = pc.in_dim >> 8;

    // xs = rmsnorm(h) * wn, redundant per WG
    {
        float acc = 0.0f;
        uint n4 = pc.in_dim >> 2;
        for (uint i = tid; i < n4; i += 256u) {
            vec4 v = vec4(h[i*4u], h[i*4u+1u], h[i*4u+2u], h[i*4u+3u]);
            xs4[i] = v; acc += dot(v, v);
        }
        red[tid] = acc;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1) {
            if (tid < s) red[tid] += red[tid + s];
            barrier();
        }
        float rstd = 1.0f / sqrt(red[0] / float(pc.in_dim) + pc.eps);
        for (uint i = tid; i < n4; i += 256u)
            xs4[i] *= rstd * vec4(wn[i*4u], wn[i*4u+1u], wn[i*4u+2u], wn[i*4u+3u]);
        barrier();
    }

    // gemv: this head's 128 rows in 8 batches of 16 rows x 16 lanes;
    // lane partials go to shared, single barrier, then 128-thread row reduce.
    uint rowLane = tid >> 4;
    uint itid = tid & 15u;
    uint t = g < pc.heads ? pc.tq : (g < pc.heads + pc.kvHeads ? pc.tk : pc.tv);
    for (uint batch = 0u; batch < pc.headDim / 16u; batch++) {
        uint lr = batch * 16u + rowLane;
        uint row = g < pc.heads ? g * pc.headDim + lr
                 : (g < pc.heads + pc.kvHeads ? (g - pc.heads) * pc.headDim + lr
                                            : (g - pc.heads - pc.kvHeads) * pc.headDim + lr);
        float acc = 0.0f;
        if (g < pc.heads) {
            if (t == 0u) GEMV_Q4K(wq, row, bpr, itid, acc)
            else         GEMV_Q6K(wq, row, bpr, itid, acc)
        } else if (g < pc.heads + pc.kvHeads) {
            if (t == 0u) GEMV_Q4K(wk, row, bpr, itid, acc)
            else         GEMV_Q6K(wk, row, bpr, itid, acc)
        } else {
            if (t == 0u) GEMV_Q4K(wv, row, bpr, itid, acc)
            else         GEMV_Q6K(wv, row, bpr, itid, acc)
        }
        parts[lr * 16u + itid] = acc;
    }
    barrier();
    if (tid < pc.headDim) {
        float s = parts[tid * 16u];
        for (uint j = 1u; j < 16u; j++) s += parts[tid * 16u + j];
        rowv[tid] = s;
    }
    barrier();

    uint pos = uint(prm.pos);
    uint kb = (g - pc.heads) * pc.headDim;   // k/v head base (valid for g>=16)

    if (g < pc.heads) {
        // q head: rope (NeoX pairs i, i+hd2) then rmsnorm(qnw) -> oq
        uint qb = g * pc.headDim;
        uint hd2 = pc.ropeDim >> 1;
        for (uint i = tid; i < hd2; i += 256u) {
            float freq = 1.0f / pow(pc.base, float(i) / float(hd2));
            float a = float(pos) * freq;
            float c = cos(a), s = sin(a);
            float x0 = rowv[i], x1 = rowv[i + hd2];
            rowv[i]       = x0 * c - x1 * s;
            rowv[i + hd2] = x0 * s + x1 * c;
        }
        barrier();
        float a2 = 0.0f;
        for (uint i = tid; i < pc.headDim; i += 256u) a2 += rowv[i] * rowv[i];
        red[tid] = a2;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1) { if (tid < s) red[tid] += red[tid + s]; barrier(); }
        float rstdQ = 1.0f / sqrt(red[0] / float(pc.headDim) + pc.eps);
        for (uint i = tid; i < pc.headDim; i += 256u)
            oq[qb + i] = rowv[i] * rstdQ * qnw[i];
    } else if (g < pc.heads + pc.kvHeads) {
        // k head: rope then rmsnorm(knw) then fp16 append at pos
        uint hd2 = pc.ropeDim >> 1;
        for (uint i = tid; i < hd2; i += 256u) {
            float freq = 1.0f / pow(pc.base, float(i) / float(hd2));
            float a = float(pos) * freq;
            float c = cos(a), s = sin(a);
            float x0 = rowv[i], x1 = rowv[i + hd2];
            rowv[i]       = x0 * c - x1 * s;
            rowv[i + hd2] = x0 * s + x1 * c;
        }
        barrier();
        float a1 = 0.0f;
        for (uint i = tid; i < pc.headDim; i += 256u) a1 += rowv[i] * rowv[i];
        red[tid] = a1;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1) { if (tid < s) red[tid] += red[tid + s]; barrier(); }
        float rstdK = 1.0f / sqrt(red[0] / float(pc.headDim) + pc.eps);
        for (uint i = tid; i < pc.headDim; i += 256u)
            kk[pos * pc.kvStride + kb + i] = f2h(rowv[i] * rstdK * knw[i]);
    } else {
        // v head: raw fp16 append at pos
        for (uint i = tid; i < pc.headDim; i += 256u)
            vv[pos * pc.kvStride + (g - pc.heads - pc.kvHeads) * pc.headDim + i] = f2h(rowv[i]);
    }
}
