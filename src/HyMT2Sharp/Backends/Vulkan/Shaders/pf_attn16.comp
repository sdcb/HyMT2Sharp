#version 450

#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Per (head, m): causal attention for one query row. Grid: (heads, seq).
// q comes from the qkv buffer (roped + per-head-normed in WG); K/V already sit
// in the fp16 caches for positions 0..pos+m (kvprep ran first).
layout(local_size_x = 1024) in;

layout(set = 0, binding = 0) readonly buffer QKV { float qkv[]; };
layout(set = 0, binding = 1) readonly buffer KK { uvec4 Kk4[]; };
layout(set = 0, binding = 2) readonly buffer VV { uint Vv32[]; };
layout(set = 0, binding = 3) readonly buffer QN { float qnw[]; };
layout(set = 0, binding = 4) readonly buffer P { int tokenId; int pos; int kvLen; int seq; } prm;
layout(set = 0, binding = 5) writeonly buffer AO { float16_t ao[]; };

layout(push_constant) uniform PC {
    uint heads; uint kvHeads; uint headDim; uint ropeDim; uint kvStride;
    uint qkvRow; float scale; float base; float eps;
} pc;

shared float sc[4096];
shared float red[256];
shared float sq[128];
shared float vp[1024];

#define WGSUM(accv, outv) { \
    float _t = subgroupAdd(accv); \
    if (subgroupElect()) red[gl_SubgroupID] = _t; \
    barrier(); \
    if (tid == 0u) { float _s = 0.0f; for (uint _i = 0u; _i < gl_NumSubgroups; _i++) _s += red[_i]; red[0] = _s; } \
    barrier(); \
    outv = red[0]; \
}

#define WGMAX(accv, outv) { \
    float _t = subgroupMax(accv); \
    if (subgroupElect()) red[gl_SubgroupID] = _t; \
    barrier(); \
    if (tid == 0u) { float _s = -3.4e38f; for (uint _i = 0u; _i < gl_NumSubgroups; _i++) _s = max(_s, red[_i]); red[0] = _s; } \
    barrier(); \
    outv = red[0]; \
}

void main()
{
    uint g = gl_WorkGroupID.x, m = gl_WorkGroupID.y, tid = gl_LocalInvocationID.x;
    uint pos = uint(prm.pos) + m;
    uint kvLen = pos + 1u;
    uint group = pc.heads / pc.kvHeads;
    uint kvh = g / group;
    uint qb = g * pc.headDim;
    uint kb = kvh * pc.headDim;
    uint hd2 = pc.ropeDim >> 1;
    uint rowQ = m * pc.qkvRow + qb;

    // stage 1: rope q row -> sq
    for (uint i = tid; i < hd2; i += 1024u) {
        float freq = 1.0f / pow(pc.base, float(i) / float(hd2));
        float a = float(pos) * freq;
        float c = cos(a), s = sin(a);
        float x0 = qkv[rowQ + i], x1 = qkv[rowQ + i + hd2];
        sq[i]       = x0 * c - x1 * s;
        sq[i + hd2] = x0 * s + x1 * c;
    }
    for (uint i = hd2 * 2u + tid; i < pc.headDim; i += 1024u)
        sq[i] = qkv[rowQ + i];
    barrier();

    // stage 2: rmsnorm sq (per-head shared qnw)
    float a2 = 0.0f;
    for (uint i = tid; i < pc.headDim; i += 1024u) a2 += sq[i] * sq[i];
    float totQ;
    WGSUM(a2, totQ)
    float rstdQ = 1.0f / sqrt(totQ / float(pc.headDim) + pc.eps);
    for (uint i = tid; i < pc.headDim; i += 1024u)
        sq[i] *= rstdQ * qnw[i];
    barrier();

    // stage 3: scores, K read as uvec4 = 8 fp16
    for (uint t = tid; t < kvLen; t += 1024u) {
        uint kk = (kb + t * pc.kvStride) >> 3;
        float acc = 0.0f;
        for (uint d8 = 0u; d8 < pc.headDim / 8u; d8++) {
            uvec4 pk = Kk4[kk + d8];
            acc += dot(vec4(unpackHalf2x16(pk.x).x, unpackHalf2x16(pk.x).y,
                            unpackHalf2x16(pk.y).x, unpackHalf2x16(pk.y).y),
                       vec4(sq[d8*8u], sq[d8*8u+1u], sq[d8*8u+2u], sq[d8*8u+3u]));
            acc += dot(vec4(unpackHalf2x16(pk.z).x, unpackHalf2x16(pk.z).y,
                            unpackHalf2x16(pk.w).x, unpackHalf2x16(pk.w).y),
                       vec4(sq[d8*8u+4u], sq[d8*8u+5u], sq[d8*8u+6u], sq[d8*8u+7u]));
        }
        sc[t] = acc * pc.scale;
    }
    barrier();

    // stage 4: softmax
    float mx = -3.4e38f;
    for (uint t = tid; t < kvLen; t += 1024u) mx = max(mx, sc[t]);
    float mxt;
    WGMAX(mx, mxt)
    float sm = 0.0f;
    for (uint t = tid; t < kvLen; t += 1024u) { sc[t] = exp(sc[t] - mxt); sm += sc[t]; }
    float smt;
    WGSUM(sm, smt)
    sm = smt;

    // stage 5: weighted V — (d, t-eighth) split across all 1024 threads
    uint vb = kvh * pc.headDim;
    uint d = tid & 127u;
    uint tq = kvLen >> 3;
    uint thf = tid >> 7;               // 0..7
    uint t0 = thf * tq;
    uint t1 = (thf == 7u) ? kvLen : min(t0 + tq, kvLen);
    float va = 0.0f;
    uint vb32 = (vb >> 1) + (d >> 1);
    uint dp = d & 1u;
    for (uint t = t0; t < t1; t++) {
        uint pk = Vv32[vb32 + t * (pc.kvStride >> 1)];
        va += sc[t] * unpackHalf2x16(dp == 0u ? (pk << 16) : pk).y;
    }
    vp[tid] = va;
    barrier();
    if (tid < pc.headDim) {
        float acc = 0.0f;
        for (uint h = 0u; h < 8u; h++) acc += vp[tid + h * 128u];
        ao[m * (pc.heads * pc.headDim) + qb + tid] = float16_t(acc / sm);
    }
}
