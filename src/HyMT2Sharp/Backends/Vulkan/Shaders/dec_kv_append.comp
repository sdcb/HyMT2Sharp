#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_16bit_storage : require
// append one token's K/V (f32) into flat fp16 KV caches at pos.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer KS { float kSrc[]; };
layout(set = 0, binding = 1) readonly buffer VS { float vSrc[]; };
layout(set = 0, binding = 2) writeonly buffer KD { uint16_t kDst[]; };
layout(set = 0, binding = 3) writeonly buffer VD { uint16_t vDst[]; };
layout(set = 0, binding = 4) readonly buffer P { int tokenId; int pos; int kvLen; } prm;

layout(push_constant) uniform PC { uint kDim; uint kvStride; } pc;

uint16_t f2h(float f) { return uint16_t(packHalf2x16(vec2(f, 0.0f)) & 0xFFFFu); }

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.kDim) return;
    uint off = uint(prm.pos) * pc.kvStride + gid;
    kDst[off] = f2h(kSrc[gid]);
    vDst[off] = f2h(vSrc[gid]);
}
