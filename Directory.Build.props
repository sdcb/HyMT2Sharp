<Project>
  <!--
    Independent NuGet versions. Edit here (and keep build/00-common.linq in sync).
    `dotnet pack -p:Version=` must not flow into referenced projects; see Directory.Build.targets.
  -->
  <PropertyGroup>
    <HyMT2SharpVersion Condition="'$(HyMT2SharpVersion)' == ''">1.0.0</HyMT2SharpVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <RootNamespace>Sdcb.$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>Sdcb.$(MSBuildProjectName)</AssemblyName>
    <PackageId>Sdcb.$(MSBuildProjectName)</PackageId>
    <Authors>sdcb</Authors>
    <Company>Sdcb</Company>
    <PackageProjectUrl>https://github.com/sdcb/HyMT2Sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sdcb/HyMT2Sharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageTags>Sdcb;HyMT2;Hy-MT2;GGUF;LLM;translation</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryType>git</PublishRepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'HyMT2Sharp'">
    <Version>$(HyMT2SharpVersion)</Version>
    <IsPackable>true</IsPackable>
    <Description>Hy-MT2 hunyuan-dense inference: GGUF, tokenize, KV cache, CPU (SIMD) and Metal backends.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="README.md" Visible="false" />
  </ItemGroup>
</Project>

